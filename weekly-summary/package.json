{
  "name": "weekly-summary",
  "version": "1.0.0",
  "description": "Generate GitLab weekly activity reports with code change analysis",
  "main": "scripts/cli.ts",
  "scripts": {
    "dev": "ts-node scripts/cli.ts",
    "build": "tsc",
    "bundle": "ncc build scripts/cli.ts -o dist --minify --no-cache",
    "start": "node dist/index.js"
  },
  "bin": {
    "weekly-report": "dist/index.js"
  },
  "keywords": [
    "gitlab",
    "weekly-report",
    "activity-tracking",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "commander": "^12.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vercel/ncc": "^0.38.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
