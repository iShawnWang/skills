# GitLab Weekly Report Generator Configuration

# Your GitLab personal access token
# Get it from: https://gitlab.com/-/user_settings/personal_access_tokens
# Required scopes: api, read_api, read_repository
GITLAB_ACCESS_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional: Your GitLab instance URL (defaults to https://gitlab.com)
# Use this if you have a self-hosted GitLab instance
# GITLAB_URL=https://gitlab.company.com
# Alternative: GITLAB_ENDPOINT=https://gitlab.company.com

# Optional: Your GitLab username
# If not provided, uses the token owner's username
# GITLAB_USERNAME=your.username
